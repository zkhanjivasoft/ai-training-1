{
  "name": "fsl-taskboard-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FullStack Labs training codebase: a task-board app for practicing AI-assisted development workflows",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "test": "npm run test -ws --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -ws --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "reset-db": "node scripts/reset-db.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
